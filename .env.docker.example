# ════════════════════════════════════════════════════════════════
#         ملف البيئة لتشغيل موج بالدوكر — انسخه إلى .env
#         وضع قيمك الحقيقية ثم شغّل: docker compose up -d
# ════════════════════════════════════════════════════════════════

# ─── إعدادات التطبيق ───
APP_NAME=موج
VERSION=1.0.0
DEBUG=False
HOST=0.0.0.0
PORT=8000

# ─── مفتاح أوبن إيه آي (مطلوب للأسئلة العامة) ───
OPENAI_API_KEY=sk-ضع_مفتاحك_هنا
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# ─── مفتاح جيمناي (مطلوب لتوليد الهويات والصور) ───
# سيتم تمريره داخل الحاوية كـ API_KEY تلقائياً
GEMINI_API_KEY=AIzaضع_مفتاحك_هنا

# ─── مفاتيح الأمان (مطلوبة) ───
# توليد مفتاح JWT عشوائي:    openssl rand -hex 32
# توليد مفتاح التشفير:        python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET_KEY=غيّر_هذا_بمفتاح_عشوائي_طويل
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ENCRYPTION_KEY=غيّر_هذا_بمفتاح_Fernet_صالح

# ─── منافذ الخوادم الفرعية (داخل الحاوية) ───
XSUITE_PORT=5789
LOGINX_PORT=5000
IDENTITY_PORT=5990

# ─── إعدادات اختيارية ───
N8N_WEBHOOK_URL=
N8N_WEBHOOK_ENABLED=False
