# ─── الخادم الخلفي لموج (FastAPI + خوادم X و LoginX و Identity) ───
FROM python:3.11-slim

# منع الأسئلة التفاعلية أثناء البناء
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONIOENCODING=utf-8 \
    PIP_NO_CACHE_DIR=1

# تثبيت مكتبات النظام التي تحتاجها Playwright وبعض المكتبات الأخرى
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        wget \
        ca-certificates \
        fonts-liberation \
        libnss3 \
        libnspr4 \
        libatk1.0-0 \
        libatk-bridge2.0-0 \
        libcups2 \
        libdrm2 \
        libxkbcommon0 \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxrandr2 \
        libgbm1 \
        libpango-1.0-0 \
        libcairo2 \
        libasound2 \
        libatspi2.0-0 \
        build-essential \
        git \
    && rm -rf /var/lib/apt/lists/*

# مجلد العمل
WORKDIR /app

# نسخ المتطلبات أولاً (للاستفادة من ذاكرة الدوكر المؤقتة)
COPY requirements.txt ./
RUN pip install --upgrade pip && pip install -r requirements.txt

# تثبيت متصفحات Playwright (Chromium يكفي للأتمتة)
RUN playwright install chromium && playwright install-deps chromium

# نسخ بقية ملفات المشروع
COPY . .

# إنشاء المجلدات اللازمة لحفظ البيانات
RUN mkdir -p /app/data /app/data/schedule_outputs /app/app/x/cookies /app/app/identity/static/generated

# تشغيل القاعدة عند أول تشغيل ثم تشغيل الخادم
EXPOSE 8000 5789 5000 5990

CMD ["sh", "-c", "python init_database.py && uvicorn app.main:app --host 0.0.0.0 --port 8000"]
