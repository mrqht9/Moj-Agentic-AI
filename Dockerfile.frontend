# ─── واجهة موج (React + Vite + Nginx) ───

# المرحلة الأولى: بناء الواجهة
FROM node:20-alpine AS builder

WORKDIR /app

# نسخ ملفات الحزم أولاً (للاستفادة من ذاكرة الدوكر المؤقتة)
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install

# نسخ بقية ملفات الواجهة وبناءها
COPY frontend/ ./
RUN npm run build


# المرحلة الثانية: تقديم الواجهة عبر Nginx
FROM nginx:alpine

# نسخ ملف إعدادات Nginx
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

# نسخ الملفات المبنية
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
